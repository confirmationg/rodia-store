# Copy to .env and fill in
PORT=3000

# WhatsApp Cloud API (Meta developers dashboard)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
VERIFY_TOKEN=rodia-verify-123
ADMIN_PHONE=234XXXXXXXXXX        # admin WhatsApp number, international format, no +

# Admin dashboard login (open /admin)
ADMIN_PASSWORD=change-me

# AI: Groq is main, NVIDIA is fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Payment (bank transfer)
BANK_NAME=
ACCOUNT_NUMBER=
ACCOUNT_NAME=RODIA Innovations

# Store rules
MIN_ORDER=0
DEFAULT_DELIVERY_FEE=1000
DB_PATH=rodia.db
