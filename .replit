modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[userenv]

[userenv.shared]
DB_PATH = "rodia.db"
DEFAULT_DELIVERY_FEE = "1000"
GROQ_MODEL = "llama-3.3-70b-versatile"
MIN_ORDER = "0"
NVIDIA_MODEL = "meta/llama-3.3-70b-instruct"
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["npm", "start"]
